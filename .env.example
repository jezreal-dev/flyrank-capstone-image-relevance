# ==============================================================================
# FlyRank Capstone — AI Image Understanding & Content Matching Engine
# Environment Configuration Template
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# AI Provider Configuration:
# - 'offline' (Default, $0 cost, deterministic local vectors + high-fidelity catalog)
# - 'gemini'  (Uses Google Gemini API free tier)
AI_PROVIDER=offline

# Optional: Google AI Studio Gemini API Key (Required ONLY if AI_PROVIDER=gemini)
# Free tier key with no credit card from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# SQLite Database Path
DATABASE_PATH=data/image_engine.db

# Matching & Mismatch Guard Thresholds
CONFIDENCE_THRESHOLD=0.70
SIMILARITY_THRESHOLD=0.60
MAX_SUGGESTIONS_PER_POST=5

# Cost & Safety Budget Guard (USD ceiling)
COST_BUDGET_LIMIT_USD=10.00
