BT /F3 7.0 Tf 0.88 0.90 0.92 rg 54.0 673.9 Td (def cosine_similarity\(v1: List[float], v2: List[float]\) -> float:) Tj ET
BT /F3 7.0 Tf 0.88 0.90 0.92 rg 54.0 663.9 Td (    norm1 = math.sqrt\(sum\(a * a for a in v1\)\)) Tj ET
BT /F3 7.0 Tf 0.88 0.90 0.92 rg 54.0 653.9 Td (    norm2 = math.sqrt\(sum\(b * b for b in v2\)\)) Tj ET
BT /F3 7.0 Tf 0.88 0.90 0.92 rg 54.0 643.9 Td (    if norm1 == 0.0 or norm2 == 0.0: return 0.0) Tj ET
BT /F3 7.0 Tf 0.88 0.90 0.92 rg 54.0 633.9 Td (    val = sum\(a * b for a, b in zip\(v1, v2\)\) / \(norm1 * norm2\)) Tj ET
BT /F3 7.0 Tf 0.88 0.90 0.92 rg 54.0 623.9 Td (    return max\(-1.0, min\(1.0, float\(val\)\)\)) Tj ET
